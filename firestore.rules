rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() { return request.auth != null; }
    
    // Check if user is signed in anonymously
    function isAnonymous() { 
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous'; 
    }
    
    // Safely check role based on known staff emails for the prototype
    function isAdmin() { return isAuthenticated() && request.auth.token.email == 'admin@restaurant.com'; }
    function isCashier() { return isAuthenticated() && request.auth.token.email == 'cashier@restaurant.com'; }
    function isKitchen() { return isAuthenticated() && request.auth.token.email == 'kitchen@restaurant.com'; }
    function isAdminOrCashier() { return isAdmin() || isCashier(); }

    // ─── MENU ───────────────────────────────────────────
    match /menu/{item} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // Cashier may toggle availability / adjust stock. Customers may only
      // DECREASE stock when ordering (and mark an item sold out) — never
      // restock or bring a sold-out dish back.
      allow update: if isAdmin() ||
        (isCashier() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'available'])) ||
        (isAnonymous() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'available']) &&
         request.resource.data.stock is number && resource.data.stock is number &&
         request.resource.data.stock >= 0 &&
         request.resource.data.stock <= resource.data.stock &&
         (request.resource.data.available == resource.data.available || request.resource.data.available == false));
    }

    // ─── SETTINGS ───────────────────────────────────────
    match /settings/{setting} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── TABLES ─────────────────────────────────────────
    match /tables/{table} {
      allow read: if true;
      allow create, delete: if isAdminOrCashier();
      // A customer scanning the QR can only seat themselves (available → occupied).
      // Freeing or reserving a table is staff-only.
      allow update: if isAdminOrCashier() || isKitchen() ||
        (isAnonymous() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'currentOrderId', 'occupiedAt', 'updatedAt']) &&
         resource.data.status == 'available' &&
         request.resource.data.status == 'occupied');
    }

    // ─── ORDERS ─────────────────────────────────────────
    match /orders/{order} {
      allow read: if true;
      // Staff can ring up paid walk-ins. Customers can only SEND an order —
      // it must start unpaid and wait for the cashier to accept it.
      allow create: if isAdminOrCashier() ||
        (isAnonymous() &&
         request.resource.data.status == 'pending' &&
         request.resource.data.paymentStatus == 'pending');
      
      // Staff can update freely. Anonymous customers may ONLY perform the
      // self-checkout transition: accepted + unpaid  →  preparing + paid,
      // optionally with adjusted items/total from the checkout page.
      allow update: if isAdminOrCashier() || isKitchen() ||
        (isAnonymous() &&
         resource.data.status == 'accepted' &&
         resource.data.paymentStatus == 'pending' &&
         request.resource.data.status == 'preparing' &&
         request.resource.data.paymentStatus == 'paid' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(
           ['status', 'paymentStatus', 'paymentMethod', 'tipAmount', 'grandTotal', 'paidAt', 'updatedAt', 'items', 'total']));

      allow delete: if isAdmin();
    }

    // ─── SERVICE REQUESTS ("Call staff") ─────────────────
    // Customers can raise a request for their table; only staff can see/close them.
    match /serviceRequests/{req} {
      allow create: if (isAnonymous() || isAdminOrCashier()) &&
        request.resource.data.status == 'open' &&
        request.resource.data.type == 'staff' &&
        request.resource.data.tableNumber is int;
      allow read, update, delete: if isAdminOrCashier() || isKitchen();
    }

    // ─── FLOOR PLANS ────────────────────────────────────
    // Staff screens show the layout; only the admin can edit it.
    match /floors/{floor} {
      allow read: if isAdminOrCashier() || isKitchen();
      allow write: if isAdmin();
    }

    // ─── USERS ──────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}