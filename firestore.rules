rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() { return request.auth != null; }
    
    // Check if user is signed in anonymously
    function isAnonymous() { 
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous'; 
    }
    
    // ─── Staff roles ─────────────────────────────────────
    // Each staff member has a profile at staff/{uid}: { name, email, role, active }.
    // The owner manages them in Admin → Staff. A deactivated profile has no role.
    function staffPath() { return /databases/$(database)/documents/staff/$(request.auth.uid); }
    function hasStaffProfile() { return isAuthenticated() && !isAnonymous() && exists(staffPath()); }

    // Bootstrap only: the original demo accounts keep their role until a profile
    // exists for them (mirrors BOOTSTRAP_ROLES in lib/staffAuth.ts).
    function legacyRole() {
      let email = request.auth.token.get('email', '');
      return email == 'admin@restaurant.com' ? 'admin'
        : email == 'cashier@restaurant.com' ? 'cashier'
        : email == 'kitchen@restaurant.com' ? 'kitchen'
        : '';
    }

    function role() {
      return !isAuthenticated() || isAnonymous() ? ''
        : hasStaffProfile()
          ? (get(staffPath()).data.get('active', true) == true ? get(staffPath()).data.role : '')
          : legacyRole();
    }

    function isAdmin() { return role() == 'admin'; }
    function isCashier() { return role() == 'cashier'; }
    function isKitchen() { return role() == 'kitchen'; }
    function isAdminOrCashier() { return role() in ['admin', 'cashier']; }

    // ─── MENU ───────────────────────────────────────────
    match /menu/{item} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // Cashier may toggle availability / adjust stock. Customers never write
      // the menu — the server reserves stock when they order (lib/server/orders.ts).
      allow update: if isAdmin() ||
        (isCashier() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'available']));
    }

    // ─── SETTINGS ───────────────────────────────────────
    match /settings/{setting} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── TABLES ─────────────────────────────────────────
    match /tables/{table} {
      allow read: if true;
      allow create, delete: if isAdminOrCashier();
      // A customer scanning the QR can only seat themselves (available → occupied).
      // Freeing or reserving a table is staff-only.
      allow update: if isAdminOrCashier() || isKitchen() ||
        (isAnonymous() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'currentOrderId', 'occupiedAt', 'updatedAt']) &&
         resource.data.status == 'available' &&
         request.resource.data.status == 'occupied');
    }

    // ─── ORDERS ─────────────────────────────────────────
    match /orders/{order} {
      // Private: staff see everything; a customer only sees orders placed from their own device.
      allow read: if isAdminOrCashier() || isKitchen() ||
        (isAuthenticated() && resource.data.customerUid == request.auth.uid);

      // Only staff write orders here. Customers order and pay through the
      // server (/api/orders), which checks the table QR code and sets every
      // price and total from the menu — the phone can't change what it pays.
      allow create: if isAdminOrCashier();
      allow update: if isAdminOrCashier() || isKitchen();

      allow delete: if isAdmin();
    }

    // ─── TABLE QR SECRETS ───────────────────────────────
    // Keyed by table number. Only the admin can see them (to print QR codes);
    // The order server (/api/orders) checks them when a customer orders.
    match /tableSecrets/{tableNumber} {
      allow read, write: if isAdmin();
    }

    // ─── SERVICE REQUESTS ("Call staff") ─────────────────
    // Customers can raise a request for their table; only staff can see/close them.
    match /serviceRequests/{req} {
      allow create: if (isAnonymous() || isAdminOrCashier()) &&
        request.resource.data.status == 'open' &&
        request.resource.data.type == 'staff' &&
        request.resource.data.tableNumber is int;
      allow read, update, delete: if isAdminOrCashier() || isKitchen();
    }

    // ─── FLOOR PLANS ────────────────────────────────────
    // Staff screens show the layout; only the admin can edit it.
    match /floors/{floor} {
      allow read: if isAdminOrCashier() || isKitchen();
      allow write: if isAdmin();
    }

    // ─── USERS ──────────────────────────────────────────
    // ─── STAFF PROFILES ─────────────────────────────────
    // Staff can read their own profile (used at login); the owner manages everyone.
    // An admin can never demote or deactivate themselves (no accidental lock-out).
    match /staff/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow create, update: if isAdmin() &&
        request.resource.data.role in ['admin', 'cashier', 'kitchen'] &&
        request.resource.data.active is bool &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 &&
        (uid != request.auth.uid || (request.resource.data.role == 'admin' && request.resource.data.active == true));
      allow delete: if isAdmin() && uid != request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}