# Copy this file to .env.local and fill in the values.
# Firebase console → Project settings → General → Your apps → Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=hapag-15b5e.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=hapag-15b5e
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=hapag-15b5e.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# NextAuth (staff login). Generate a secret with:  npx auth secret   or   openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Optional: comma-separated LAN IPs allowed to load the dev server (phones scanning QR codes)
# DEV_ORIGINS=192.168.1.18

# Server key for customer orders/payments (never commit). Locally: save it as service-account.json
# in this folder instead. On hosting (Vercel): paste the JSON (or base64 of it) here.
# FIREBASE_SERVICE_ACCOUNT=

# Online payments. "practice" = built-in practice checkout, no real money (default).
# Later: paymongo / xendit once that connector and account are set up.
PAYMENT_PROVIDER=practice
# Secret used to sign/verify payment webhooks (falls back to NEXTAUTH_SECRET)
# PAYMENT_WEBHOOK_SECRET=

# Public demo / portfolio site only — NEVER for a real restaurant (see docs/DEPLOY-DEMO.md)
# NEXT_PUBLIC_DEMO_MODE=true
# CRON_SECRET=          # protects the nightly demo reset (/api/demo/reset)
