# Copy this file to .env.local and fill in the values.
# Firebase console → Project settings → General → Your apps → Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=qrsystem-ff65a.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=qrsystem-ff65a
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=qrsystem-ff65a.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# NextAuth (staff login). Generate a secret with:  npx auth secret   or   openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Optional: comma-separated LAN IPs allowed to load the dev server (phones scanning QR codes)
# DEV_ORIGINS=192.168.1.18
